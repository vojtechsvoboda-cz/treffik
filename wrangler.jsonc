{
  "name": "treffik",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Databáze pro komentáře. Wrangler ji při prvním nasazení sám vytvoří a propojí.
  "d1_databases": [{ "binding": "DB", "database_name": "treffik-comments" }]
}
